# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# MediaPipe model: 7.5 MB third-party binary, re-downloadable (see README)
models/*.task

# Captured and generated data. Recordings are session-specific; results are
# derived from the reference tracker dataset and are not ours to publish.
recordings/
results/

# Reference tracker dataset, kept here only so the comparison scripts have it
# locally. It is the professor's data and contains photographs of people, so it
# stays out of this public repo.
reference/

# Generated training sets and model runs — rebuildable from the script, and
# the source images belong to the Ultralytics dataset, not to us.
datasets/
runs/
captures/
